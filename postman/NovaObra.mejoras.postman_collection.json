{
  "info": {
    "name": "NovaObra · Mejoras y reportes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Verificación automatizada de reportes, comprobantes, inventario bajo, nombres, filtros, paginación y CSV con API/MySQL reales. Ejecutar en orden sobre una base de pruebas. Crea fixtures propios, captura identificadores y no modifica registros ajenos. Cancela sus operaciones comerciales al finalizar para dejar el producto en stock cero; conserva el historial. No contiene credenciales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001/api"
    }
  ],
  "item": [
    {
      "name": "001 · Conexión MySQL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId','pm-mej-'+Date.now()+'-'+pm.variables.replaceIn('{{$guid}}').slice(0,8));",
              "pm.collectionVariables.set('formulaName','=PM-'+pm.collectionVariables.get('runId'));",
              "pm.collectionVariables.set('formulaQuery',encodeURIComponent(pm.collectionVariables.get('formulaName')));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.equal(200); });",
              "pm.test('JSON real', function () { pm.response.to.be.json; });",
              "var resultPayload=pm.response.json();",
              "pm.test(\"Base conectada\", function () { pm.expect(resultPayload.database).to.equal('connected'); });"
            ]
          }
        }
      ]
    },
